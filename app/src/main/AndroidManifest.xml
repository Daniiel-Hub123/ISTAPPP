<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.g2c2.istappp">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_finaliconppp_foreground"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_finaliconppp_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.ISTAPPP"
        android:usesCleartextTraffic="true"
        >
        <activity
            android:configChanges="uiMode"
            android:name=".SistemaActivity"
            android:label="@string/title_activity_sistema"
            android:theme="@style/Theme.ISTAPPP.NoActionBar" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.ISTAPPP.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>