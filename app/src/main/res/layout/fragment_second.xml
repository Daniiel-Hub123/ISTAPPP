<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vistaconvoc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".SecondFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclercon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        >


    </androidx.recyclerview.widget.RecyclerView>


    <Button
        android:id="@+id/button_second"
        android:layout_width="150dp"
        android:layout_height="75dp"
        android:layout_marginVertical="650dp"
        android:layout_marginLeft="135dp"
        android:layout_marginTop="22dp"
        android:text="Regresar" />

    <TextView
        android:id="@+id/nocon"
        android:layout_width="212dp"
        android:layout_height="140dp"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="255dp"
        android:background="@drawable/style_txt"
        android:gravity="center"
        android:text="En este momento no hay convocatorias abiertas, estese atento a las fuentes oficiales del ISTA."
        android:textSize="20sp"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/barrap"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="180dp"
        android:layout_marginTop="300dp"
        android:progressTint="#FAC02E" />


</RelativeLayout>