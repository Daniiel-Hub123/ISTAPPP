<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ISTAPPP" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#FAC02E</item>
        <item name="colorPrimaryVariant">#F6D070</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/black</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>

        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.ISTAPPP.NoActionBar">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.ISTAPPP.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.ISTAPPP.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
</resources>